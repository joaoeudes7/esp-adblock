# Copy this file to `config.env` (gitignored) and fill it in.
# It is read at BUILD time (tools/gen_config.py) to bake credentials so the
# device needs no runtime provisioning:
#   - src/secrets.h  -> compiled into the firmware
#   - data/wifi.cfg  -> baked into the LittleFS image (uploadfs); read at boot
# Leave a value empty to skip it. Comments start with '#'.

# Leave WIFI_SSID empty to provision at runtime via SmartConfig instead.
WIFI_SSID=
WIFI_PASS=

# Optional static IPv4. Leave WIFI_IP empty to use DHCP. If set, set WIFI_GW too
# (WIFI_DNS is the resolver the ESP ITSELF uses; defaults to 1.1.1.1). WIFI_HOST is the DHCP/mDNS name.
WIFI_IP=
WIFI_GW=
WIFI_DNS=1.1.1.1
WIFI_HOST=esp-adblock

# Upstream resolver(s) the device FORWARDS client queries to. Comma-separated, up to 4
# (default: Cloudflare 1.1.1.1). The device probes each every minute and uses the fastest;
# runtime-changeable from the dashboard / /setdns. Quad9 = 9.9.9.9, Google = 8.8.8.8.
UPSTREAM_DNS=1.1.1.1

# Dashboard login (HTTP Basic). Also used for OTA — there is no separate OTA password.
WEB_USER=admin
WEB_PASS=change-me-please

# Blocked reply: ip (ESP IP -> block page), zero (0.0.0.0), or nxdomain. Runtime-changeable.
BLOCK_MODE=ip
# IPv4-only: strip AAAA answers (clients using this resolver stay on IPv4). Runtime-changeable.
IPV4_ONLY=1
# Keyword heuristic: also block hosts whose labels are ad/tracker tokens (ads, adserver,
# tracker, analytics, ...). Off by default (some false-positive risk). Runtime-changeable.
KEYWORD_BLOCK=1
# DNS-rebinding guard (opt-in): drop upstream answers pointing at private IPs. Off by
# default — it also drops legitimate split-horizon answers. Runtime-changeable.
REBIND_GUARD=0
# Privacy/security response-header level (baked at build):
#   0 = off · 1 = basic (nosniff, X-Frame-Options, Referrer-Policy)
#   2 = standard (+ Permissions-Policy, X-Robots-Tag, X-DNS-Prefetch-Control, CSP) [default]
#   3 = strict (+ Cross-Origin-Opener/Resource-Policy)
PRIVACY_LEVEL=2
# SafeSearch (opt-in): force SafeSearch per search engine. Bitmask: 1=Google, 2=YouTube,
# 4=Bing, 8=DuckDuckGo (e.g. 3 = Google+YouTube, 15 = all). Needs IPV4_ONLY=1 (else IPv6 bypasses).
SAFESEARCH=0

# Optional remote syslog for blocked events (history off-device). Leave host empty to disable.
SYSLOG_HOST=
SYSLOG_PORT=514
